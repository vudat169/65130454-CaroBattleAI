<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <TextView
        android:id="@+id/tvTurnStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lượt của: Người chơi X"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/gridBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:background="#CCCCCC"
        android:padding="4dp"
        app:layout_bottom_toTopOf="@id/btnReset"
        app:layout_constraintTop_toBottomOf="@id/tvTurnStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btn_0_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_0_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_0_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_0_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />

        <Button android:id="@+id/btn_1_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_1_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_1_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_1_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />

        <Button android:id="@+id/btn_2_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_2_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_2_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_2_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />

        <Button android:id="@+id/btn_3_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_3_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_3_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />
        <Button android:id="@+id/btn_3_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:layout_margin="2dp" tools:ignore="SpeakableTextPresentCheck" />

    </GridLayout>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="Chơi lại"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>