<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <TextView
        android:id="@+id/tvTurnStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lượt của: Người chơi X"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/gridBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:background="#CCCCCC"
        android:padding="2dp"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintTop_toBottomOf="@id/tvTurnStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_0_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_0_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_0_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_0_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_1_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_1_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_1_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_1_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_2_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_2_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_2_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_2_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_3_0" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_3_1" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_3_2" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_3_3" android:layout_width="75dp" android:layout_height="75dp" android:text="" android:textSize="32sp" android:textStyle="bold" android:background="@drawable/cell_background" android:layout_margin="1dp" tools:ignore="SpeakableTextPresentCheck" />

    </GridLayout>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Chơi lại" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trở về" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>