<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:padding="24dp"
    tools:context=".BoardChooserActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BATTLE ZONE"
        android:textColor="#00FFCC"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="60dp"
        android:shadowColor="#00FFCC"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CHỌN KÍCH THƯỚC BÀN CỜ"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBoard4x4"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:text="BÀN CỜ 4 X 4\n[ LUẬT THẮNG 4 Ô ]"
        android:textColor="#FF3366"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#25161A"
        android:layout_marginTop="60dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBoard5x5"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:text="BÀN CỜ 5 X 5\n[ LUẬT THẮNG 5 Ô ]"
        android:textColor="#3399FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#162030"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnBoard4x4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="QUAY LẠI MÀN HÌNH CHÍNH"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#2A2A32"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>